# Three real guests: each k3s node has its own kernel and local disk.
prefix = ENV.fetch("AAT_NETWORK_PREFIX", "192.168.56")
abort "Invalid AAT_NETWORK_PREFIX" unless prefix.match?(/\A\d{1,3}\.\d{1,3}\.\d{1,3}\z/) && prefix.split(".").all? { |n| n.to_i <= 255 }
token = File.expand_path("../.state/cluster-token", __dir__)
abort "Run task up first (cluster token missing)" unless File.file?(token)

Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("AAT_VM_BOX", "bento/ubuntu-24.04")
  config.vm.box_version = ENV["AAT_VM_BOX_VERSION"] if ENV["AAT_VM_BOX_VERSION"]
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 900

  %w[aat-control aat-worker-1 aat-worker-2].each_with_index do |name, index|
    ip = "#{prefix}.#{10 + index}"
    config.vm.define name, primary: index == 0 do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: ip
      node.vm.provider :libvirt do |provider|
        provider.driver = ENV.fetch("AAT_VM_DRIVER", "kvm")
        if provider.driver == "qemu"
          provider.cpu_mode = "custom"
          provider.cpu_model = "qemu64"
        end
        # RAM is in MiB: 6 GiB for the control plane, 3 GiB for each worker.
        if index == 0
          provider.cpus = ENV.fetch("AAT_CONTROL_CPUS", ENV.fetch("AAT_VM_CPUS", "4")).to_i
          provider.memory = ENV.fetch("AAT_CONTROL_MEMORY", "6144").to_i
        else
          provider.cpus = ENV.fetch("AAT_WORKER_CPUS", ENV.fetch("AAT_VM_CPUS", "2")).to_i
          provider.memory = ENV.fetch("AAT_WORKER_MEMORY", "3072").to_i
        end
        provider.default_prefix = "aat-m2"
      end
      node.vm.provision "file", source: token, destination: "/tmp/aat-k3s-token"
      node.vm.provision "clock", type: "shell", path: "sync-clock.sh", run: "always", args: [
        index == 0 ? "server" : "agent", "#{prefix}.10"
      ]
      node.vm.provision "shell", path: "provision-node.sh", args: [
        index == 0 ? "server" : "agent", name, ip, "#{prefix}.10",
        ENV.fetch("K3S_VERSION", "v1.34.5+k3s1")
      ]
    end
  end
end
