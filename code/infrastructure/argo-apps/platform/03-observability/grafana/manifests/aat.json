{
  "uid": "aat-local",
  "title": "AAT — layanan dan runtime lokal",
  "schemaVersion": 40,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Throughput HTTP per service (dari log)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate({k8s_namespace_name=\"sistem-informasi-kebencanaan-bnpb\"} | json | msg=\"request\" | __error__=\"\" [1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "title": "Error rate HTTP 5xx per service",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate({k8s_namespace_name=\"sistem-informasi-kebencanaan-bnpb\"} | json | msg=\"request\" | __error__=\"\" | status >= 500 [5m])) / sum by(service) (rate({k8s_namespace_name=\"sistem-informasi-kebencanaan-bnpb\"} | json | msg=\"request\" | __error__=\"\" [5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 3,
      "title": "p95 latensi HTTP per service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {k8s_namespace_name=\"sistem-informasi-kebencanaan-bnpb\"} | json | msg=\"request\" | __error__=\"\" | unwrap latency_ms | __error__=\"\" [5m]) by(service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 4,
      "title": "CPU container AAT",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod) (rate(container_cpu_usage_seconds_total{namespace=\"sistem-informasi-kebencanaan-bnpb\",container!=\"\",container!=\"POD\"}[2m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memori container AAT",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod) (container_memory_working_set_bytes{namespace=\"sistem-informasi-kebencanaan-bnpb\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 6,
      "title": "Replica siap",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"sistem-informasi-kebencanaan-bnpb\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Log AAT; cari correlation_id di Explore",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s_namespace_name=\"sistem-informasi-kebencanaan-bnpb\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Trace lintas service",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "Buka **Explore → Tempo** untuk trace OTLP. Aplikasi harus diinstrumentasi dan meneruskan trace context. Mengatur OTEL_* saja tidak menginstrumentasi binary Go lama. Log ber-correlation ID dapat ditelusuri melalui Loki."
      }
    }
  ]
}
