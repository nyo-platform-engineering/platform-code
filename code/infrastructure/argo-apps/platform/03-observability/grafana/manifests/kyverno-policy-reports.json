      "targets": [
        {
          "refId": "A",
          "expr": "sum({__name__=~\"policy_report_result|cluster_policy_report_result\",job=\"policy-reporter\",namespace=~\"$namespace\",policy=~\"$policy\",status=\"error\"}) or (0 * max(up{job=\"policy-reporter\"} == 1))",
          "instant": true,
          "range": false,
          "legendFormat": "{{status}}",
          "datasource": {
