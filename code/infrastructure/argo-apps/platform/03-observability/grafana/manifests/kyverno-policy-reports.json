          "refId": "A",
          "expr": "{createdBy=\"policy-reporter\",namespace=~\"$namespace\",policy=~\"$policy\",status=~\"fail|error|warn\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
