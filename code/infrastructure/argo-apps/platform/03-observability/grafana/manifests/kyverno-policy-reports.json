{
  "uid": "kyverno-policy-reports",
  "title": "Kyverno Policy Reports",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "kyverno",
    "policies"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values({__name__=~\"policy_report_result|cluster_policy_report_result\",job=\"policy-reporter\"}, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"policy_report_result|cluster_policy_report_result\",job=\"policy-reporter\"}, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "policy",
        "label": "Policy",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values({__name__=~\"policy_report_result|cluster_policy_report_result\",job=\"policy-reporter\"}, policy)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"policy_report_result|cluster_policy_report_result\",job=\"policy-reporter\"}, policy)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Kyverno policy reports",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Current policy/resource results from Kyverno ? Policy Reporter ? OpenTelemetry ? Mimir. **Ownership is in Audit**: violations are reported, writes are allowed. Counts include separate results for Pods and their controllers; they are not unique workload counts. Check **Collection healthy** before interpreting zero failures. Reports reflect the last Kyverno evaluation. Loki retains new result events, including failure messages, after resources are deleted."
      }
    },
    {
      "id": 2,
      "title": "Failures",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum({__name__=~\"policy_report_result|cluster_policy_report_result\",job=\"policy-reporter\",namespace=~\"$namespace\",policy=~\"$policy\",status=\"fail\"}) or (0 * max(up{job=\"policy-reporter\"} == 1))",
          "instant": true,
          "range": false,
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Evaluation errors",
      "type": "stat",
      "gridPos": {
        "x": 4,
