    {
      "id": 11,
      "title": "Failing policy/resource results",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true
            },
            "indexByName": {
              "namespace": 0,
              "kind": 1,
              "name": 2,
              "policy": 3,
              "status": 4,
              "rule": 5,
              "source": 6
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "namespace",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"policy_report_result|cluster_policy_report_result\",job=\"policy-reporter\",namespace=~\"$namespace\",policy=~\"$policy\",status=~\"fail|error|warn\"} > 0",
          "instant": true,
          "range": false,
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "format": "table"
        }
      ]
    },
    {
      "id": 12,
      "title": "Policy event history ? including violation messages",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
