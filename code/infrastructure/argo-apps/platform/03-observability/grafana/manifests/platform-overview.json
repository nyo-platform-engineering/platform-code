{
  "uid": "platform-overview",
  "title": "Platform Overview",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "platform",
    "kubernetes",
    "argocd"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Traces",
      "url": "http://telemetry.localhost/traces?service=go-demo&minutes=15",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "Logs",
      "url": "http://telemetry.localhost/logs?service=go-demo&minutes=15",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "Policy details",
      "url": "/d/kyverno-policy-reports",
      "type": "link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(kube_pod_status_ready, namespace)",
        "query": {
          "query": "label_values(kube_pod_status_ready, namespace)",
          "refId": "namespace"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Platform overview",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "### Local platform \u00b7 operations overview\nLive Mimir metrics collected through OpenTelemetry. **Namespace** filters workloads and policy results; scrape and Argo CD panels remain cluster-wide. CPU is **cores**, memory is container **working set**. Most sources scrape every **60 seconds**. Pod readiness includes completed Jobs; policy totals count rule/resource results, not unique workloads. Missing telemetry remains \u201cNo data\u201d."
      }
    },
    {
      "id": 2,
      "title": "Scrape targets up",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "Cluster-wide collection availability, not application readiness.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(up) / count(up)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "title": "Pods ready",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "Fraction of observed pods reporting Ready=true; includes completed Jobs.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(kube_pod_status_ready{condition=\"true\",namespace=~\"${namespace:regex}\"}) / count(kube_pod_status_ready{condition=\"true\",namespace=~\"${namespace:regex}\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "title": "Container CPU",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "description": "CPU time consumed per second across selected workload containers.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"${namespace:regex}\",container!=\"\",container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true
      }
    },
