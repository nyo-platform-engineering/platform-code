{
  "uid": "node-utilization",
  "title": "Node utilization",
  "description": "OS metrics from the OTel agent on each k3s VM, collected every 30 seconds via hostmetrics \u2192 cluster collector \u2192 Mimir. Averages and peaks use only available samples in the selected time range; no history is backfilled.",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "tags": [
    "platform",
    "nodes",
    "capacity"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(system_memory_limit_bytes, node)",
          "refId": "node-variable"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU average",
      "description": "Time average over the selected dashboard range. Percentage of all VM vCPUs; sampled from one-minute-or-longer CPU rates.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((sum by (node) (rate(system_cpu_time_seconds_total{node=~\"$node\",state!=\"idle\"}[$__rate_interval])) / sum by (node) (rate(system_cpu_time_seconds_total{node=~\"$node\"}[$__rate_interval])))[$__range:30s])",
          "legendFormat": "{{node}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "CPU peak",
      "description": "Largest sampled CPU rate in the selected range; not an instantaneous peak.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time((sum by (node) (rate(system_cpu_time_seconds_total{node=~\"$node\",state!=\"idle\"}[$__rate_interval])) / sum by (node) (rate(system_cpu_time_seconds_total{node=~\"$node\"}[$__rate_interval])))[$__range:30s])",
          "legendFormat": "{{node}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "RAM average",
      "description": "Average of total RAM minus Linux MemAvailable over the selected range.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((max by (node) (system_memory_limit_bytes{node=~\"$node\"}) - max by (node) (system_linux_memory_available_bytes{node=~\"$node\"}))[$__range:30s])",
          "legendFormat": "{{node}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "RAM peak",
      "description": "Largest observed total RAM minus Linux MemAvailable over the selected range. No samples exist before hostmetrics starts.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time((max by (node) (system_memory_limit_bytes{node=~\"$node\"}) - max by (node) (system_linux_memory_available_bytes{node=~\"$node\"}))[$__range:30s])",
          "legendFormat": "{{node}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "CPU utilization",
      "description": "Fraction of VM CPU time spent outside idle, including I/O wait and steal. Includes OS, k3s, and workloads.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(system_cpu_time_seconds_total{node=~\"$node\",state!=\"idle\"}[$__rate_interval])) / sum by (node) (rate(system_cpu_time_seconds_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "RAM used and capacity",
      "description": "Used = total minus MemAvailable. Reclaimable cache remains available; this differs from cAdvisor working set.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node) (system_memory_limit_bytes{node=~\"$node\"}) - max by (node) (system_linux_memory_available_bytes{node=~\"$node\"})",
          "legendFormat": "{{node}} used",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "max by (node) (system_memory_limit_bytes{node=~\"$node\"})",
          "legendFormat": "{{node}} capacity",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Root filesystem used and capacity",
      "description": "Only the VM root filesystem; capacity includes reserved blocks. Persistent volumes, images, logs, and the OS share this disk.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (system_filesystem_usage_bytes{node=~\"$node\",mountpoint=\"/\",state=\"used\"})",
          "legendFormat": "{{node}} used",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (node) (system_filesystem_usage_bytes{node=~\"$node\",mountpoint=\"/\"})",
          "legendFormat": "{{node}} capacity",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Disk throughput",
      "description": "Read/write byte rates across VM block devices, excluding loop and RAM devices.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, direction) (rate(system_disk_io_bytes_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}} {{direction}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Network throughput",
      "description": "VM NIC traffic. Loopback, pod veths, bridges, and Flannel interfaces are excluded to reduce double-counting.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, direction) (rate(system_network_io_bytes_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}} {{direction}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Load average (1 minute)",
      "description": "Runnable and uninterruptible tasks. This is a task count, not a CPU percentage; compare with the VM vCPU count.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node) (system_cpu_load_average_1m{node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
