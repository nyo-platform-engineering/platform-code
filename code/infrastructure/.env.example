# File ini dokumentasi; scripts/runtime.py tidak mengeksekusi shell/env file.
# task up menghasilkan .env.runtime dengan token acak untuk service lokal.
# Token eksternal dari asisten dapat ditambahkan ke .env.runtime saat integrasinya
# tersedia di kode aplikasi; jangan gunakan nilai contoh ini pada demo.
AUDIT_TOKEN=REPLACE_WITH_ASSISTANT_AUDIT_TOKEN
PANTAI_AUTH_TOKEN=REPLACE_WITH_ASSISTANT_SENSOR_TOKEN
SATELLITE_GROUP_TOKEN=REPLACE_WITH_ASSISTANT_GROUP_TOKEN
