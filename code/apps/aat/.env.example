# Contoh saja. Salin ke .env lalu ganti semua nilai kredensial.
BMKG_API_KEY=example-bmkg-change-me
PVMBG_TOKEN=example-pvmbg-change-me
AGGREGATOR_TOKEN=example-aggregator-change-me
POSTGRES_USER=aat
POSTGRES_PASSWORD=example-database-change-me
POSTGRES_DB=aat
BMKG_PORT=8081
PVMBG_PORT=8082
AGGREGATOR_PORT=8083
BMKG_DELAY_MS=100
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
EVENT_INTERVAL_SECONDS=10
DB_MAX_CONNS=5
POLL_INTERVAL_SECONDS=3
POLL_TIMEOUT_MS=4000
NATS_URL=nats://nats:4222

# Bagian 2: jalankan python3 scripts/setup-client-env.py setelah .env dibuat.
AUTH_INTERNAL_TOKEN=example-auth-internal-change-me
PUBLIC_CLIENT_SECRET=example-public-client-change-me
RESPONDER_CLIENT_SECRET=example-responder-client-change-me
ANALYST_CLIENT_SECRET=example-analyst-client-change-me
AUTH_PORT=8084
CLIENT_PORT=8080
ACCESS_TTL_SECONDS=60
REFRESH_TTL_SECONDS=3600
AUTH_MAX_SESSIONS=1000
AUTH_MAX_CONCURRENT=32
CLIENT_MAX_CONCURRENT=16
UPSTREAM_TIMEOUT_MS=3000
STALE_AFTER_SECONDS=60
