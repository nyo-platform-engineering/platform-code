# Contoh saja. Salin ke .env lalu ganti semua nilai kredensial.
BMKG_API_KEY=example-bmkg-change-me
PVMBG_TOKEN=example-pvmbg-change-me
AGGREGATOR_TOKEN=example-aggregator-change-me
POSTGRES_USER=aat
POSTGRES_PASSWORD=example-database-change-me
POSTGRES_DB=aat
BMKG_PORT=8081
PVMBG_PORT=8082
AGGREGATOR_PORT=8083
BMKG_DELAY_MS=100
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
EVENT_INTERVAL_SECONDS=10
# Diisi sekali oleh scripts/setup-env.py; jangan diubah saat restart service.
# Contoh: START_TIME=2026-10-08T17:00:00+07:00
START_TIME=
# Satu koneksi per sesi pemilik sumber (BMKG, PVMBG, satelit, sensor) ditambah koneksi API
# dan READ_PRIORITY_SLOTS slot baca yang dicadangkan untuk Tim Lapangan/BNPB Internal.
DB_MAX_CONNS=9
READ_PRIORITY_SLOTS=1
# Gunakan koneksi langsung atau session pooling. Interval 1..9 detik.
POLL_INTERVAL_SECONDS=3
POLL_TIMEOUT_MS=4000
PVMBG_SCHEMA_POLICY=strict
FIELD_REPORT_PROCESSOR_ENABLED=true
NATS_URL=nats://nats:4222

# Bagian 2: jalankan python3 scripts/setup-client-env.py setelah .env dibuat.
AUTH_INTERNAL_TOKEN=example-auth-internal-change-me
PUBLIC_CLIENT_SECRET=example-public-client-change-me
RESPONDER_CLIENT_SECRET=example-responder-client-change-me
ANALYST_CLIENT_SECRET=example-analyst-client-change-me
AUTH_PORT=8084
CLIENT_PORT=8080
ACCESS_TTL_SECONDS=60
REFRESH_TTL_SECONDS=3600
AUTH_MAX_SESSIONS=1000
AUTH_MAX_CONCURRENT=32
CLIENT_MAX_CONCURRENT=16
UPSTREAM_TIMEOUT_MS=3000
STALE_AFTER_SECONDS=60

# M2 Audit API: token asisten untuk demo; lokal dibuat oleh setup-env.py.
AUDIT_TOKEN=example-audit-change-me
# Node DATABASE, bukan node Aggregator. Isi hostname dari kubectl get nodes saat demo.
# Untuk Compose, isi identitas host storage yang benar bila memakai endpoint location.
STORE_NODE_NAME=
STORE_UNIT=postgres

# OTel tracing; kosong = tidak mengekspor dari pengembangan lokal.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
# Untuk sampling: parentbased_traceidratio dan arg antara 0 dan 1.
OTEL_TRACES_SAMPLER_ARG=1

# P4 Feed Satelit. Token grup dari asisten (rahasia, jangan di-commit); kosong = consumer satelit tidak berjalan.
SATELLITE_FEED_URL=https://satellite.naufarrel.dev
SATELLITE_GROUP_TOKEN=
# Batas keterlambatan deteksi (menit) relatif terhadap waktu deteksi terbaru.
SATELLITE_ALLOWED_LATENESS_MINUTES=360
# Jumlah event per transaksi; offset feed disimpan pada transaksi yang sama.
SATELLITE_BATCH_SIZE=200

# P5 Sensor Pantai. Token dipilih kelompok sendiri (dibuat setup-env.py), dipakai sensor
# dan Aggregator; kosong = poller sensor tidak berjalan. Profil demo: exam (+ berkas kunci asisten).
PANTAI_AUTH_TOKEN=example-pantai-change-me
PANTAI_PROFILE=practice
PANTAI_SEED=42
PANTAI_SPEED=60
SENSOR_POLL_INTERVAL_MS=1000
SENSOR_TIMEOUT_MS=2000
# Tanpa bacaan baru selama ini (dalam waktu sensor) data dianggap basi.
SENSOR_STALE_AFTER_SECONDS=900
# Porsi slot Client API yang boleh dipakai Media; sisanya dicadangkan untuk Tim Lapangan.
# 20% dari 16 = 3, sama dengan slot baca bersama Aggregator (1 per pod x 3 pod), sehingga
# Media ditolak di Client API, bukan di Aggregator.
CLIENT_MEDIA_SHARE_PERCENT=20
CLIENT_IDENTITY_CACHE_SECONDS=10
