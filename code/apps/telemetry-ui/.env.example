# Load from backend/: set -a; . ../.env; set +a
AUTH_MODE=oauth
# Use 5173 for Vite dev, or the public HTTPS origin when deployed.
AUTH_ORIGIN=http://127.0.0.1:5173
AUTH_DATABASE_URL=postgres://telemetry_auth:local-auth-only@127.0.0.1:5433/telemetry_auth?sslmode=disable
AUTH_GRANTS_FILE=../auth.grants.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MOCK=true
MAX_CONCURRENT_QUERIES=4
LISTEN_HOST=127.0.0.1
PORT=8080
# Used only by compose.auth.yaml for the development PostgreSQL instance.
AUTH_POSTGRES_PASSWORD=local-auth-only
