# Load from backend/: set -a; . ../.env; set +a
AUTH_MODE=oauth
# Use 5173 for Vite dev, or the public HTTPS origin when deployed.
AUTH_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://telemetry_auth:local-auth-only@127.0.0.1:5433/telemetry_auth?sslmode=disable
AUTH_SESSION_LIFETIME=8h
AUTH_IDLE_TIMEOUT=30m
AUTH_RENEWAL_INTERVAL=15m
AUTH_GRANTS_FILE=../auth.grants.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MOCK=true
MAX_CONCURRENT_QUERIES=4
LISTEN_HOST=127.0.0.1
PORT=8080
# sslmode=disable is accepted only with the loopback development origin above.
# Production HTTPS origins require sslmode=verify-full.
# Used only by compose.auth.yaml for the development PostgreSQL instance.
AUTH_POSTGRES_PASSWORD=local-auth-only
