{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "authMode": {
      "enum": [
        "local",
        "oauth"
      ]
    },
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "traces": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "passwordSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "dependencies": {
                "name": [
                  "key"
                ],
                "key": [
                  "name"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "logs": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "passwordSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "dependencies": {
                "name": [
                  "key"
                ],
                "key": [
                  "name"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "unified": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "passwordSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "dependencies": {
                "name": [
                  "key"
                ],
                "key": [
                  "name"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "type": {
          "type": "string",
          "enum": [
            "unified",
            "split"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "unified"
              }
            }
          },
          "then": {
            "required": [
              "unified"
            ],
            "properties": {
              "unified": {
                "type": "object",
                "required": [
                  "address",
                  "username",
                  "passwordSecret"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "minLength": 1
                  },
                  "username": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passwordSecret": {
                    "type": "object",
                    "required": [
                      "name",
                      "key"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "split"
              }
            }
          },
          "then": {
            "required": [
              "traces",
              "logs"
            ],
            "properties": {
              "traces": {
                "type": "object",
                "required": [
                  "address",
                  "username",
                  "passwordSecret"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "minLength": 1
                  },
                  "username": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passwordSecret": {
                    "type": "object",
                    "required": [
                      "name",
                      "key"
                    ]
                  }
                }
              },
              "logs": {
                "type": "object",
                "required": [
                  "address",
                  "username",
                  "passwordSecret"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "minLength": 1
                  },
                  "username": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passwordSecret": {
                    "type": "object",
                    "required": [
                      "name",
                      "key"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "oneOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "valueFrom"
            ]
          }
        ]
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 15
    },
    "authGrantsSecret": {
      "type": "string"
    }
  }
}
