{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "passwordSecret": {
      "type": "object",
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "catalogDataSource": {
      "type": "object",
      "required": ["id", "address", "database", "username", "secure", "passwordEnv", "passwordSecret"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "address": {"type": "string", "minLength": 1},
        "database": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "secure": {"type": "boolean"},
        "passwordEnv": {"type": "string", "pattern": "^CLICKHOUSE_[A-Z0-9_]+$"},
        "passwordSecret": {"$ref": "#/definitions/passwordSecret"}
      },
      "additionalProperties": false
    },
    "identityMatch": {
      "type": "object",
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "email": {"type": "string", "format": "email"},
        "domain": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"}
      },
      "additionalProperties": false,
      "oneOf": [
        {"required": ["subject"]},
        {"required": ["email"]},
        {"required": ["domain"]}
      ]
    },
    "identityMapping": {
      "type": "object",
      "required": ["provider", "match", "permissions"],
      "properties": {
        "provider": {"enum": ["google", "github"]},
        "match": {"$ref": "#/definitions/identityMatch"},
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "observability:traces:read",
              "observability:logs:read",
              "observability:metadata:read",
              "observability:admin:read"
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"provider": {"const": "github"}}},
          "then": {"properties": {"match": {"required": ["subject"]}}}
        }
      ]
    },
    "organizationDataSources": {
      "type": "object",
      "required": ["unified", "traces", "logs"],
      "properties": {
        "unified": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "traces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "logs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "required": ["id", "name", "telemetryScope", "identityMappings", "dataSources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "name": {"type": "string", "minLength": 1},
        "telemetryScope": {"type": "string", "minLength": 1},
        "identityMappings": {"type": "array", "items": {"$ref": "#/definitions/identityMapping"}},
        "dataSources": {"$ref": "#/definitions/organizationDataSources"}
      },
      "additionalProperties": false
    },
    "dataSourceGroups": {
      "type": "object",
      "required": ["unified", "traces", "logs"],
      "properties": {
        "unified": {"type": "array", "items": {"$ref": "#/definitions/catalogDataSource"}},
        "traces": {"type": "array", "items": {"$ref": "#/definitions/catalogDataSource"}},
        "logs": {"type": "array", "items": {"$ref": "#/definitions/catalogDataSource"}}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "authMode": {"enum": ["local", "oauth"]},
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/organization"}
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "clickhouse": {
      "type": "object",
      "required": ["dataSources"],
      "properties": {
        "dataSources": {"$ref": "#/definitions/dataSourceGroups"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "dataSources": {
              "anyOf": [
                {"properties": {"unified": {"minItems": 1}}},
                {"properties": {"traces": {"minItems": 1}}},
                {"properties": {"logs": {"minItems": 1}}}
              ]
            }
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "string"},
          "valueFrom": {"type": "object"}
        },
        "oneOf": [{"required": ["value"]}, {"required": ["valueFrom"]}]
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 15},
    "authSessionLifetime": {"type": "string", "pattern": "^[0-9]+(m|h)$"},
    "authIdleTimeout": {"type": "string", "pattern": "^[0-9]+(m|h)$"},
    "authRenewalInterval": {"type": "string", "pattern": "^[0-9]+(m|h)$"}
  }
}
